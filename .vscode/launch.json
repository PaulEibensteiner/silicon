{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "scala",
            "request": "launch",
            "name": "Silicon Configurable Tests",
            "testClass": "viper.silicon.ConfigurableSiliconTests",
            "jvmOptions": [
                "-Xss128m",
                "-DSILICON_CONFIG_FILE=${input:siliconConfigFile}",
                "-DSILICON_LOG_PATH=/home/paul/master-thesis/msc-peibensteine/tryout-results/SE-PC-check-temp/0-silicon.log",
                "-DROOT_DIR=${workspaceFolder}/.."
            ],
        },
        {
            "type": "scala",
            "request": "launch",
            "name": "Silicon Run",
            "mainClass": "viper.silicon.SiliconRunner",
            "buildTarget": "silicon",
            "args": [
                "--assumeInjectivityOnInhale",
                "--useOldAxiomatization",
                "--timeout=600",
                "--disableCatchingExceptions",
                "--numberOfParallelVerifiers=1",
                "--numberOfErrorsToReport=0",
                "--proverSaturationTimeout=156",
                "--proverSaturationTimeoutWeights=[0.40,0.69,0.49,0.00,0.51]",
                "--checkTimeout=9",
                "--assertTimeout=3",
                "--qpSplitTimeout=531",
                "--prover=Z3-API",
                "--maskHeapMode",
                "--proverLogFile=/home/paul/master-thesis/msc-peibensteine/tryout-results/check-logging-.smt2",
                "/home/paul/master-thesis/msc-peibensteine/tryout-targets/examples-11.1.vpr"
            ],
            "envFile": "${workspaceFolder}/../msc-peibensteine/.env"
        }
    ],
    "inputs": [
        {
            "id": "viperFile",
            "type": "command",
            "command": "extension.commandvariable.file.pickFile",
            "args": {
                "include": "tryout-targets/**/*.vpr",
                "description": "Select viper file",
                "fromWorkspace": "msc-peibensteine",
            }
        },
        {
            "id": "siliconConfigFile",
            "type": "command",
            "command": "extension.commandvariable.file.pickFile",
            "args": {
                "include": "${workspaceFolder}/../backend-configs/silicon/*.json",
                "fromWorkspace": "msc-peibensteine",
                "description": "Select the backend config file"
            }
        }
    ]
}